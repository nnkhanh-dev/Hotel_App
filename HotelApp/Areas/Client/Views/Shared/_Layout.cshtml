<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, initial-scale=1, maximum-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>@ViewData["Title"] - HotelManage</title>
    <meta name="keywords" content="" />
    <meta name="description" content="" />
    <meta name="author" content="" />

    <!-- Bootstrap 4 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/navbar-responsive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/floating-chat.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/client-navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/carousel-fix.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modal-styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css">
    <link rel="stylesheet" href="~/css/jquery.mCustomScrollbar.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/fancybox/2.1.5/jquery.fancybox.min.css" media="screen">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <link rel="stylesheet" href="~/css/slider.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
</head>
<body>
    <header class="main-header">
        <div class="header-container">
            <div class="logo-section">
                <a href="@Url.Action("Index", "Hotel")" class="logo-link">
                    <h1 class="logo-text">
                        <span class="logo-ute">UTE</span><span class="logo-hotel">Hotel</span>
                    </h1>
                </a>
            </div>
            
            <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle menu">
                <span class="hamburger-line"></span>
                <span class="hamburger-line"></span>
                <span class="hamburger-line"></span>
            </button>

            <nav class="main-nav" id="mainNav">
                <ul class="nav-menu">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Hotel")">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("TypePage", "Hotel")">Phòng</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("VoucherPage", "Hotel")">Ưu đãi</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("ContactPage", "Hotel")">Liên hệ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Rooms", "Hotel")">Đặt phòng</a>
                    </li>
                    <li class="nav-item nav-item-dropdown mobile-only">
                        <a class="nav-link" href="javascript:void(0)">
                            <i class="fa fa-user-circle"></i> Tài khoản
                            <i class="fa fa-chevron-down dropdown-icon"></i>
                        </a>
                        <ul class="nav-submenu">
                            <li><a href="/Account/Profile"><i class="fa fa-user"></i> Quản lý tài khoản</a></li>
                            <li><a href="/Client/BookingList"><i class="fa fa-calendar-check-o"></i> Đơn đặt phòng</a></li>
                            <li><a href="/dang-xuat" class="text-danger"><i class="fa fa-sign-out"></i> Đăng xuất</a></li>
                        </ul>
                    </li>
                </ul>
                <div class="user-menu-wrapper desktop-only">
                    <button class="btn-user-menu" id="userMenuButton" aria-label="User menu">
                        <i class="fa fa-user-circle"></i>
                        <span class="user-name">Khách hàng</span>
                        <i class="fa fa-chevron-down"></i>
                    </button>
                    <div class="user-dropdown-menu" id="userDropdownMenu">
                        <div class="dropdown-header">
                            <i class="fa fa-user-circle" style="font-size: 40px;"></i>
                            <div class="user-info">
                                <strong>Xin chào!</strong>
                                <small>Khách hàng UTEHotel</small>
                            </div>
                        </div>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item" href="/Account/Profile">
                            <i class="fa fa-user"></i> Quản lý tài khoản
                        </a>
                        <a class="dropdown-item" href="/Client/BookingList">
                            <i class="fa fa-calendar-check-o"></i> Đơn đặt phòng
                        </a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item text-danger" href="/dang-xuat">
                            <i class="fa fa-sign-out"></i> Đăng xuất
                        </a>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    @RenderBody()

    <footer>
        <div class="footer">
            <div class="container">
                <div class="row">
                    <div class=" col-md-4">
                        <h3>Liên hệ chúng tôi</h3>
                        <ul class="conta">
                            <li><i class="fa fa-map-marker" aria-hidden="true"></i>48 Cao Thắng, Hải Châu, Đà Nẵng, Việt Nam</li>
                            <li><i class="fa fa-mobile" aria-hidden="true"></i>0898866467</li>
                            <li> <i class="fa fa-envelope" aria-hidden="true"></i><a href="#"> nguyennhatkhanh151203@gmail.com</a></li>
                        </ul>
                    </div>
                    <div class="col-md-4">
                        <h3>Nội dung</h3>
                        <ul class="link_menu">
                            <li><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                            <li><a href="@Url.Action("TypePage", "Home")"> Phòng</a></li>
                            <li><a href="@Url.Action("VoucherPage", "Home")">Ưu đãi</a></li>
                            <li><a href="@Url.Action("ContactPage", "Home")">Liên hệ</a></li>
                            <li><a href="@Url.Action("Rooms", "Home")">Đặt phòng</a></li>
                        </ul>
                    </div>
                    <div class="col-md-4">
                        <h3>Mạng xã hội</h3>
                        <ul class="social_icon">
                            <li><a href="#"><i class="fa fa-facebook" aria-hidden="true"></i></a></li>
                            <li><a href="#"><i class="fa fa-twitter" aria-hidden="true"></i></a></li>
                            <li><a href="#"><i class="fa fa-linkedin" aria-hidden="true"></i></a></li>
                            <li><a href="#"><i class="fa fa-youtube-play" aria-hidden="true"></i></a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.13/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/navbar.js" asp-append-version="true"></script>
    <script src="~/js/client-navbar.js" asp-append-version="true"></script>
    <script src="~/loaddata/loadroomtypes.js"></script>
    <script src="~/loaddata/loadvouchers.js"></script>
    <script src="~/loadData/LoadListRoom.js"></script>
    <script src="~/loadData/LoadAmenities.js"></script>
    <script src="~/loadData/LoadAreas.js"></script>
    <script src="~/loadData/LoadBooking.js"></script>
    <script src="~/loadData/loadTopRooms.js"></script>
    <!-- Thông báo -->
    <script>
        $(document).ready(function () {
        @if (TempData["SuccessMessage"] != null)
        {
            <text>toastr.success("@TempData["SuccessMessage"]");</text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>toastr.error("@TempData["ErrorMessage"]");</text>
        }
                        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Floating Chat Widget -->
    @await Html.PartialAsync("_FloatingChat")
    <script src="~/js/floating-chat.js" asp-append-version="true"></script>
</body>
</html>
